# 이 파일을 .env로 복사한 뒤 실제 값을 채워넣으세요. .env는 절대 커밋하지 마세요.

# 도메인이 정해지면 채우기 (DuckDNS 예시: https://lottoanalysis.duckdns.org)
SITE_URL=
SITE_NAME=로또 6/45 분석
SITE_DESCRIPTION=

# 구글 애드센스 승인 후, 발급받은 발행자 ID를 채우면 광고가 자동으로 켜집니다.
# 예: ca-pub-1234567890123456
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_INLINE=

# 구글/네이버 서치콘솔 소유 확인용 (각 콘솔에서 "HTML 태그" 방식으로 발급받은 content 값만 붙여넣기)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# 게시판 글은 이 비밀번호로도 지울 수 있습니다 (글쓴이 비밀번호를 몰라도 관리자가 삭제 가능).
# 비워두면 관리자 삭제 기능이 꺼집니다. 충분히 길고 추측하기 어려운 값을 쓰세요.
BOARD_ADMIN_PASSWORD=
